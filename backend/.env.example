# HackData V2 Backend — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env to git.

# === Application ===
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# === CORS (comma-separated origins) ===
# Development:
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production (set to your actual Vercel URL):
# ALLOWED_ORIGINS=https://hackdata-v2.vercel.app

# === AI Provider (Groq) ===
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_ASSISTANT_API_KEY=your_groq_assistant_key_here

# === Supabase (production durable storage) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# === Redis / Valkey Queue (production distributed jobs) ===
# Leave empty for local development (uses in-process threading)
# Set to Render Key Value connection string for production
REDIS_URL=

# === Synthetic Generation Limits ===
MAX_ROW_COUNT=10000
DEFAULT_PREVIEW_ROWS=50
MAX_UPLOAD_SIZE_MB=50

# === SMTP Email ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Synthetic Data Generator
